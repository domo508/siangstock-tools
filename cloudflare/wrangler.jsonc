{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siangstock-inventory-rules",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "siangstock.com/api/rules*",
      "zone_name": "siangstock.com"
    },
    {
      "pattern": "siangstock.com/api/procurement*",
      "zone_name": "siangstock.com"
    }
  ],
  "triggers": {
    "crons": ["17 18 * * *"]
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://siangstock.com",
    "ADMIN_EMAILS": "evan0728@siangapato.com.tw,siang01@siangapato.com.tw",
    "GOOGLE_OAUTH_CLIENT_ID": "911829041789-nchtp93ot5e617g2pshq01ktq5a90r7g.apps.googleusercontent.com",
    "ACCESS_TEAM_DOMAIN": "https://restless-band-7fc2.cloudflareaccess.com",
    "ACCESS_AUD": "fbba64a4f03b08aed53ef51bc84ac02ea756acb40e1ccc6ade275104f708932d",
    "PROCUREMENT_ACCESS_AUD": "1c1f9c08ffe0a08629dd5e89d4c2e03d79fa61fa7182475513e2fc685202360b"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inventory-rules",
      "database_id": "81766d2c-43c9-4180-806f-867fef201b3b",
      "migrations_dir": "worker/migrations"
    }
  ]
}
