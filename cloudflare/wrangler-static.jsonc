{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siangstock-tools-static-assets",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "../dist/static-site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
